# PlutoLab — Root-level environment template.
# 复制为 .env 后填入实际值。.env 已被 .gitignore 排除，不入库。
#
# 各子应用有自己的 .env.example：
#   apps/web/.env.example  — Next.js 前端
#   apps/api/.env.example  — FastAPI 后端
# 根 .env 只放 docker compose 用的变量。

# ─── PostgreSQL (docker-compose) ──────────────────────────
POSTGRES_USER=pluto
POSTGRES_PASSWORD=changeme
POSTGRES_DB=pluto
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# 后端用的连接串（asyncpg 驱动）
DATABASE_URL=postgresql+asyncpg://pluto:changeme@localhost:5432/pluto

# ─── Redis ────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ─── 通用 ─────────────────────────────────────────────────
NODE_ENV=development
TZ=Asia/Shanghai
