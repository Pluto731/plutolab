# PlutoLab — 生产环境变量 (VPS 上 .env.prod, 已 .gitignore)
# 复制为 .env.prod 后填实际值

# ─── PostgreSQL ───────────────────────────
POSTGRES_USER=pluto
POSTGRES_PASSWORD=changeme_strong_password_here
POSTGRES_DB=pluto

# ─── 公网访问的 host (用于 CORS 白名单, 域名或 IP 都行) ─────────
# 例: PUBLIC_HOST=plutolab.dev
# 例: PUBLIC_HOST=23.95.25.153
PUBLIC_HOST=23.95.25.153

# ─── Auth / JWT (Phase 2.a) ───────────────
# 必填! 生成: openssl rand -hex 32
JWT_SECRET=change_me_openssl_rand_hex_32

# ─── GitHub OAuth (Phase 2.2, 可选) ───────
# GitHub → Settings → Developer settings → OAuth Apps → New OAuth App
# Authorization callback URL: http://23.95.25.153/auth/github/callback
# 留空则 GitHub 登录按钮自动禁用
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ─── 邮件 (Phase 2.3) ─────────────────────
# 默认走 docker compose 里的 mailhog 容器, 邮件不真出 VPS, 只能在 Web UI 看
# Web UI: http://${PUBLIC_HOST}:8025  (无认证, demo 用; 真切 SMTP 后可改 compose 撤端口)
# 如需真发邮件, 在此处覆盖 SMTP_HOST/SMTP_PORT/SMTP_USER/SMTP_PASSWORD 即可
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_START_TLS=true

# 生产其他环境变量 (Phase 1+ 加):
# ANTHROPIC_API_KEY=sk-ant-...
