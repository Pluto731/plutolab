# PlutoLab — 生产环境变量 (VPS 上 .env.prod, 已 .gitignore)
# 复制为 .env.prod 后填实际值

# ─── PostgreSQL ───────────────────────────
POSTGRES_USER=pluto
POSTGRES_PASSWORD=changeme_strong_password_here
POSTGRES_DB=pluto

# ─── 公网访问的 host (用于 CORS 白名单, 域名或 IP 都行) ─────────
# 例: PUBLIC_HOST=plutolab.dev
# 例: PUBLIC_HOST=23.95.25.153
PUBLIC_HOST=23.95.25.153

# ─── Auth / JWT (Phase 2.a) ───────────────
# 必填! 生成: openssl rand -hex 32
JWT_SECRET=change_me_openssl_rand_hex_32

# ─── GitHub OAuth (Phase 2.2, 可选) ───────
# GitHub → Settings → Developer settings → OAuth Apps → New OAuth App
# Authorization callback URL: http://23.95.25.153/auth/github/callback
# 留空则 GitHub 登录按钮自动禁用
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# 生产其他环境变量 (Phase 1+ 加):
# ANTHROPIC_API_KEY=sk-ant-...
# GITHUB_OAUTH_CLIENT_ID=...
# GITHUB_OAUTH_CLIENT_SECRET=...
