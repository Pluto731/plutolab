# PlutoLab API — 环境变量模板
# 复制为 .env (本目录) 后填实际值。.env 已被根 .gitignore 排除。

# ─── App ───────────────────────────
ENV=development
VERSION=0.0.1
LOG_LEVEL=INFO

# ─── Server ────────────────────────
API_HOST=0.0.0.0
API_PORT=8000

# ─── CORS (开发) ───────────────────
# JSON 数组格式，pydantic-settings 自动解析
CORS_ORIGINS=["http://localhost:3000","http://localhost:8080"]

# ─── Database (Phase 0.3.b) ────────
DATABASE_URL=postgresql+asyncpg://pluto:changeme@localhost:5432/pluto

# ─── Redis (Phase 0.3.b) ───────────
REDIS_URL=redis://localhost:6379/0

# ─── Auth / JWT (Phase 2.a) ────────
# 生产务必用强随机值: openssl rand -hex 32
JWT_SECRET=change-me-to-a-32+-byte-random-secret
JWT_ACCESS_TTL_MIN=15
JWT_REFRESH_TTL_DAYS=7

# ─── 头像存储 (Phase 2.4.c) ────────
# dev 用项目内 ./_avatars; prod 用 docker volume 挂载的 /data/avatars
AVATAR_DIR=./_avatars

# ─── GitHub OAuth (Phase 2.2) ──────
# GitHub → Settings → Developer settings → OAuth Apps → New
# callback URL: http(s)://<host>/auth/github/callback
# 留空则 GitHub 登录按钮自动禁用
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
